                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "68c1869b-c385-4e69-a40a-294a81068323",
                              "version": "KqlParameterItem/1.0",
                              "name": "DatabaseCollectionFilterClause",
                              "type": 1,
                              "criteriaData": [
                                {
                                  "criteriaContext": {
