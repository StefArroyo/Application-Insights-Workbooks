                              "rightValType": "param",
                              "resultValType": "static",
                              "resultVal": "| where AccountName == toupper('{Resources:Name}')"
                            }
                          },
                          {
                            "criteriaContext": {
                              "leftOperand": "Container",
                              "operator": "is Empty",
                              "rightValType": "param",
                              "resultValType": "static",
                              "resultVal": "| where AccountName == toupper('{Resources:Name}') and DatabaseName == '{Database}' "
                            }
                          },
                          {
                            "criteriaContext": {
                              "operator": "Default",
                              "resultValType": "static",
                              "resultVal": "| where AccountName == toupper('{Resources:Name}') and DatabaseName == '{Database}' and CollectionName == '{Container}'"
                            }
                          }
                        ],
                        "timeContext": {
                          "durationMs": 86400000
                        }
                      }
                    ],
                    "style": "pills",
                    "queryType": 0,
                    "resourceType": "microsoft.documentdb/databaseaccounts"
                  },
                  "conditionalVisibility": {
                    "parameterName": "Param",
                    "comparison": "isNotEqualTo"
                  },
                  "name": "parameters - 16"
                },
                {
                  "type": 1,
                  "content": {
                    "json": " <div style=\"padding: 20px 24px; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px \r\n4px -2px rgba(0,0,0,0.03);\">\r\n   <div style=\"display: flex; align-items: center; gap: 10px; margin-bottom: 8px;\">\r\n     <span style=\"background: #0078d4; padding: 6px 10px; border-radius: 8px; font-size: 16px;\">🔍</span>\r\n     <h2 style=\"color: #0f172a; margin: 0; font-weight: 700; font-size: 20px; letter-spacing: -0.3px;\">Diagnostics Logs</h2>\r\n   </div>\r\n   <p style=\"color: #1b1b1b; margin: 0 0 14px 0; font-size: 13px; line-height: 1.5;\">Query performance, partition key statistics, and resource \r\nconsumption from CDB diagnostic tables.</p>\r\n   <div style=\"padding: 10px 14px; background: linear-gradient(135deg, #fffbeb 0%, #fef9c3 100%); border-radius: 8px; border: 1px solid #fde68a;\">\r\n     <p style=\"color: #92400e; margin: 0; font-size: 12px; line-height: 1.6;\">\r\n       <span style=\"font-size: 14px;\">⚡</span> <strong>Setup required</strong>: Enable <code style=\"background: #dbeafe; padding: 3px 8px; \r\nborder-radius: 5px; color: #1d4ed8; font-size: 11px; font-weight: 500;\">CDBPartitionKeyStatistics</code> under Diagnostics Settings to view logical partition storage skew. Select your workspace below once enabled. Allow ~24 hours for data to populate.\r\n     </p>\r\n   </div>\r\n </div>"
                  },
                  "conditionalVisibility": {
                    "parameterName": "IsCDBPartitionKeyStatisticsEnabled",
                    "comparison": "isNotEqualTo",
                    "parameterValue": "true"
                  },
                  "name": "text - 24 - Copy"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "<h3 style=\"font-family: 'Segoe UI', sans-serif; font-weight: 600; font-size: 16px; color: #0f172a; margin: 16px 0 4px 0;\">📊 Partition Key Statistics (Log Analytics)</h3>\r\n<p style=\"font-size: 13px; color: #475569; margin: 0 0 8px 0;\">Select your Log Analytics workspace to view partition-level diagnostics data.</p>"
                  },
                  "conditionalVisibility": {
                    "parameterName": "IsCDBPartitionKeyStatisticsEnabled",
                    "comparison": "isEqualTo",
                    "parameterValue": "true"
                  },
                  "name": "text-diagnostics-logs-title"
                },
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "crossComponentResources": [
                      "value::all"
                    ],
                    "parameters": [
                      {
                        "id": "43a7b8db-707f-4f94-bea9-4fe38b8e1c16",
                        "version": "KqlParameterItem/1.0",
                        "name": "LogAnalyticsWorkspace",
                        "label": "Log Analytics Workspace",
                        "type": 5,
                        "query": "resources\r\n| where type == \"microsoft.operationalinsights/workspaces\"\r\n| project id",
                        "crossComponentResources": [
                          "value::all"
                        ],
                        "value": null,
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "timeContext": {
                          "durationMs": 86400000
                        },
                        "queryType": 1,
                        "resourceType": "microsoft.resourcegraph/resources"
                      }
                    ],
                    "style": "pills",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources"
                  },
                  "customWidth": "50",
                  "name": "parameters - 21"
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "b1c2d3e4-f5a6-7890-bcde-f01234567890",
                              "version": "KqlParameterItem/1.0",
                              "name": "DiagCDBPKSRaw",
                              "type": 1,
                              "isHiddenWhenLocked": true,
                              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{Resources}/providers/microsoft.insights/diagnosticSettings\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2021-05-01-preview\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[*].properties.logs[?(@.category=='CDBPartitionKeyStatistics' && @.enabled==true)]\",\"columns\":[{\"path\":\"$.category\",\"columnid\":\"category\"}]}}]}",
                              "queryType": 12
                            },
                            {
                              "id": "b1c2d3e4-f5a6-7890-bcde-f01234567891",
                              "version": "KqlParameterItem/1.0",
                              "name": "IsCDBPartitionKeyStatisticsEnabled",
                              "type": 1,
                              "isHiddenWhenLocked": true,
                              "criteriaData": [
                                {
                                  "criteriaContext": {
                                    "leftOperand": "DiagCDBPKSRaw",
                                    "operator": "contains",
                                    "rightValType": "static",
                                    "rightVal": "CDBPartitionKeyStatistics",
                                    "resultValType": "static",
                                    "resultVal": "true"
                                  }
                                },
                                {
                                  "criteriaContext": {
                                    "operator": "Default",
                                    "rightValType": "param",
                                    "resultValType": "static",
                                    "resultVal": ""
                                  }
                                }
                              ]
                            }
                          ],
                          "style": "pills",
                          "queryType": 0,
                          "resourceType": "microsoft.documentdb/databaseaccounts"
                        },
                        "name": "param-check-cdbpks-enabled"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "CDBPartitionKeyStatistics\r\n {DatabaseCollectionFilterClause}                                                                                 \r\n// Get the latest storage size for each logical partition key value                                                                     \r\n| summarize arg_max(TimeGenerated, *) by AccountName, DatabaseName, CollectionName, _ResourceId, PartitionKey                           \r\n| extend utilizationOf20GBLogicalPartition = SizeKb / (20.0 * 1024.0 * 1024.0) // Current storage / 20GB                                \r\n| project TimeGenerated, AccountName, DatabaseName, CollectionName, _ResourceId, PartitionKey, SizeKb, utilizationOf20GBLogicalPartition",
                          "size": 0,
                          "aggregation": 2,
                          "showAnnotations": true,
                          "showAnalytics": true,
                          "title": "Logical Partition Storage Skew",
                          "noDataMessage": "No logical partition storage skewness within your selected resource.",
                          "noDataMessageStyle": 3,
                          "timeContextFromParameter": "TimeRange",
                          "timeBrushParameterName": "TimeRange",
                          "timeBrushExportOnlyWhenBrushed": true,
                          "showRefreshButton": true,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "crossComponentResources": [
                            "/subscriptions/8dad10ed-97e6-41aa-8594-a1497297897a/resourceGroups/DefaultResourceGroup-EUS/providers/Microsoft.OperationalInsights/workspaces/DefaultWorkspace-8dad10ed-97e6-41aa-8594-a1497297897a-EUS"
                          ],
                          "visualization": "table",
                          "gridSettings": {
                            "rowLimit": 500
                          },
                          "sortBy": [],
                          "chartSettings": {
                            "showLegend": true
                          }
                        },
                        "customWidth": "100",
                        "conditionalVisibility": {
                          "parameterName": "LogAnalyticsWorkspace",
                          "comparison": "isNotEqualTo"
                        },
                        "name": "query - 14 - Copy - Copy - Copy",
                        "styleSettings": {
                          "maxWidth": "50"
                        }
                      },
                      {
                        "type": 12,
                        "content": {
                          "version": "NotebookGroup/1.0",
                          "groupType": "editable",
                          "items": [
                            {
                              "type": 3,
                              "content": {
                                "version": "KqlItem/1.0",
                                "query": "let partitionKeyRangeId = {PartitionKeyRangeId}; \r\nlet OthersThreshold = 5.0;\r\nlet HotThreshold = 80.0;\r\nCDBPartitionKeyRUConsumption \r\n{DatabaseCollectionFilterClause}\r\n| where PartitionKeyRangeId == partitionKeyRangeId\r\n| where isnotempty(PartitionKey)\r\n// 1. Calculate RU per PK per hour\r\n| summarize RU_Usage = sum(RequestCharge) by Hour = bin(TimeGenerated, 1h), PartitionKey\r\n// 2. Calculate Total per hour to find the percentage share\r\n| as T\r\n| join kind=inner (\r\n    T | summarize TotalRU_PerHour = sum(RU_Usage) by Hour\r\n) on Hour\r\n| extend RU_Percentage = round(toreal(RU_Usage) * 100.0/ toreal(TotalRU_PerHour), 2)\r\n// 3. Categorize: If < 5%, label as \"Others\". Otherwise, keep the PartitionKey.\r\n| extend DisplayKey = iif(RU_Percentage < OthersThreshold, \"Others\", PartitionKey)\r\n// 4. Re-summarize to merge all \"Others\" into one row per hour\r\n| summarize \r\n    RU_Usage = sum(RU_Usage), \r\n    RU_Percentage = sum(RU_Percentage) \r\n    by Hour, DisplayKey, TotalRU_PerHour\r\n| project Hour, PartitionKey = DisplayKey, RU_Usage, RU_Percentage, TotalRU_PerHour\r\n| order by Hour asc, RU_Usage desc",
                                "size": 0,
                                "aggregation": 2,
                                "showAnnotations": true,
                                "showAnalytics": true,
                                "title": "Consumed RU % by Logical Key",
                                "noDataMessageStyle": 5,
                                "timeContextFromParameter": "TimeRange",
                                "showRefreshButton": true,
                                "queryType": 0,
                                "resourceType": "microsoft.operationalinsights/workspaces",
                                "crossComponentResources": [
                                  "/subscriptions/8dad10ed-97e6-41aa-8594-a1497297897a/resourceGroups/DefaultResourceGroup-EUS/providers/Microsoft.OperationalInsights/workspaces/DefaultWorkspace-8dad10ed-97e6-41aa-8594-a1497297897a-EUS"
                                ],
                                "visualization": "barchart",
                                "gridSettings": {
                                  "rowLimit": 500
                                },
                                "sortBy": [],
                                "chartSettings": {
                                  "xAxis": "Hour",
                                  "yAxis": [
                                    "RU_Percentage"
                                  ],
                                  "group": "PartitionKey",
                                  "createOtherGroup": 0,
                                  "showLegend": true,
                                  "seriesLabelSettings": [
                                    {
                                      "seriesName": "$_thresholdLine",
                                      "label": "Hot Partition Threshold Per Key",
                                      "color": "redBright"
                                    }
                                  ],
                                  "customThresholdLine": "80",
                                  "customThresholdLineStyle": 3,
                                  "ySettings": {
                                    "numberFormatSettings": {
                                      "unit": 1,
                                      "options": {
                                        "style": "decimal",
                                        "useGrouping": false
                                      }
                                    },
                                    "max": 100
                                  }
                                }
                              },
                              "customWidth": "100",
                              "name": "query - 14 - Copy - Copy",
                              "styleSettings": {
                                "maxWidth": "50"
                              }
                            },
                            {
                              "type": 3,
                              "content": {
                                "version": "KqlItem/1.0",
                                "query": "let partitionKeyRangeId = {PartitionKeyRangeId}; \r\nlet OthersThreshold = 5.0;\r\nlet HotThreshold = 80.0;\r\n// Step 1: RU per PK per hour\r\nlet PerHour = \r\nCDBPartitionKeyRUConsumption \r\n{DatabaseCollectionFilterClause}\r\n| where PartitionKeyRangeId == partitionKeyRangeId\r\n| where isnotempty(PartitionKey)\r\n    | summarize RU_Usage = sum(RequestCharge) by Hour = bin(TimeGenerated, 1h), PartitionKey;\r\n// Step 2: Total RU and distinct PK count per hour\r\nlet HourTotals =\r\n    PerHour\r\n    | summarize \r\n        TotalRU_PerHour = sum(RU_Usage),\r\n        DistinctKeys    = dcount(PartitionKey)\r\n      by Hour;\r\n// Step 3: Per-hour percentage and skew label\r\nlet PerHourLabeled =\r\n    PerHour\r\n    | join kind=inner HourTotals on Hour\r\n    | extend RU_Percentage = round(toreal(RU_Usage) * 100.0 / toreal(TotalRU_PerHour), 2)\r\n    | extend FairSharePct  = round(100.0 / toreal(DistinctKeys), 2)\r\n    | extend SkewRatio     = round(RU_Percentage / FairSharePct, 1)\r\n    | extend HourLabel     = case(\r\n        RU_Percentage >= HotThreshold,  \"Hot\",\r\n //       RU_Percentage >= WarmThreshold, \"Warm\",\r\n        \"Normal\");\r\n// Step 4: Roll up across the full time window per partition key\r\nPerHourLabeled\r\n| summarize\r\n    TotalRU          = sum(RU_Usage),\r\n    TotalHours       = dcount(Hour),\r\n    HotHours         = dcountif(Hour, HourLabel == \"Hot\"),\r\n //   WarmHours        = dcountif(Hour, HourLabel == \"Warm\"),\r\n    NormalHours      = dcountif(Hour, HourLabel == \"Normal\"),\r\n    PeakRU_Pct       = round(max(RU_Percentage), 2),\r\n    AvgRU_Pct        = round(avg(RU_Percentage), 2)\r\n  by PartitionKey\r\n// Compute % of hours the key was hot\r\n| extend HotHoursPct  = round(toreal(HotHours)  * 100.0 / toreal(TotalHours), 1)\r\n// Overall verdict: Hot if it was hot in >10% of hours, else Normal\r\n| extend OverallLabel = case(\r\n    HotHoursPct  > 25.0, \"🔥 Hot\",\r\n    \"✅ Normal\")\r\n| project\r\n    PartitionKey,\r\n    OverallLabel,\r\n    HotHoursPct,    // % of hours this key was dominant (>80% of RUs)\r\n  //  WarmHoursPct,   // % of hours this key was warm (40–80% of RUs)\r\n    PeakRU_Pct,     // highest single-hour percent across one key\r\n    AvgRU_Pct,      // average % share across all hours\r\n    TotalRU,\r\n    TotalHours,\r\n    HotHours,\r\n   // WarmHours,\r\n    NormalHours\r\n| extend Recommendation = case(\r\n    OverallLabel == \"🔥 Hot\",\r\n        strcat(\"This partition key consumed over 80% of the container's RUs in \", tostring(HotHours), \" of \", tostring(TotalHours), \" hours (\", tostring(HotHoursPct), \"%). \"\r\n               \"This is a hot partition; \"\r\n               \"Consider redistribution of throughput <INSERT LINK TO DOC.>\"),\r\n    strcat(\"This partition key consumed an average of \", tostring(AvgRU_Pct), \"% of the container's RUs, peaking at \", tostring(PeakRU_Pct), \"%. \"\r\n           \"Traffic is well-distributed. No action needed.\"))\r\n| project PartitionKey, HotnessIndicator = OverallLabel, Recommendation\r\n| extend Link = iff(HotnessIndicator == \"✅ Normal\", \" N/A \", \"https://learn.microsoft.com/en-us/azure/cosmos-db/how-to-redistribute-throughput-across-partitions?tabs=nosql&pivots=azure-cli\")\r\n//| order by HotHoursPct desc, PeakRU_Pct desc\r\n\r\n",
                                "size": 0,
                                "aggregation": 2,
                                "showAnnotations": true,
                                "showAnalytics": true,
                                "title": "Consumed RU % by Logical Key",
                                "noDataMessageStyle": 5,
                                "timeContextFromParameter": "TimeRange",
                                "showRefreshButton": true,
                                "queryType": 0,
                                "resourceType": "microsoft.operationalinsights/workspaces",
                                "crossComponentResources": [
                                  "/subscriptions/8dad10ed-97e6-41aa-8594-a1497297897a/resourceGroups/DefaultResourceGroup-EUS/providers/Microsoft.OperationalInsights/workspaces/DefaultWorkspace-8dad10ed-97e6-41aa-8594-a1497297897a-EUS"
                                ],
                                "visualization": "table",
                                "gridSettings": {
                                  "formatters": [
                                    {
                                      "columnMatch": "Recommendation",
                                      "formatter": 1
                                    },
                                    {
                                      "columnMatch": "Link",
                                      "formatter": 7,
                                      "formatOptions": {
                                        "linkTarget": "Url"
                                      }
                                    }
                                  ],
                                  "rowLimit": 500
                                },
                                "sortBy": [],
                                "chartSettings": {
                                  "xAxis": "Hour",
                                  "yAxis": [
                                    "RU_Percentage"
                                  ],
                                  "group": "PartitionKey",
                                  "createOtherGroup": 0,
                                  "showLegend": true,
                                  "seriesLabelSettings": [
                                    {
                                      "seriesName": "$_thresholdLine",
                                      "label": "Hot Partition Threshold Per Key",
                                      "color": "redBright"
                                    }
                                  ],
                                  "customThresholdLine": "80",
                                  "customThresholdLineStyle": 3,
                                  "ySettings": {
                                    "numberFormatSettings": {
                                      "unit": 1,
                                      "options": {
                                        "style": "decimal",
                                        "useGrouping": false
                                      }
                                    },
                                    "max": 100
                                  }
                                }
                              },
                              "customWidth": "100",
                              "name": "query - 14 - Copy - Copy - Copy",
                              "styleSettings": {
                                "maxWidth": "50"
                              }
                            }
                          ]
                        },
                        "conditionalVisibility": {
                          "parameterName": "PartitionKeyRangeId",
                          "comparison": "isNotEqualTo"
                        },
                        "name": "group - 4"
                      }
                    ]
                  },
                  "name": "group - 7"
                }
              ]
            },
            "customWidth": "50",
            "name": "Logs"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Storage"
      },
      "name": "Storage"
    },
    {
      "type": 12,
