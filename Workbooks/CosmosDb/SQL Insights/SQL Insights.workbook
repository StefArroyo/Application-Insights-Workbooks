                              "metric": "microsoft.documentdb/databaseaccounts-Requests-PhysicalPartitionCount",
                              "aggregation": 3,
                              "splitBy": [
                                "CollectionName",
                                "DatabaseName"
                              ]
                            }
                          ],
                          "title": "Physical Partition Count",
                          "graphSettings": {
                            "type": 0,
                            "topContent": {
                              "columnMatch": "Subscription",
                              "formatter": 1
